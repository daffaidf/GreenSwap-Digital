# PostgreSQL - Supabase / Neon / Postgres lokal
# Pakai connection pooler (port 5432 / 6543) untuk serverless (Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth.js - generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-random-string"
NEXTAUTH_URL="http://localhost:3000"
