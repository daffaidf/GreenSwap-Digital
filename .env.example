# PostgreSQL - Supabase / Neon / Postgres lokal
# Runtime aplikasi (serverless/Vercel): pakai transaction pooler (6543) + pgbouncer=true
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI (migrate/resolve/db push): pakai session pooler (5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# NextAuth.js - generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-random-string"
NEXTAUTH_URL="http://localhost:3000"
